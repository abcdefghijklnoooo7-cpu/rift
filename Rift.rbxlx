end
local practice=UI.button(home,"Training",0,0,112,48,function() leaveFor("Training Arena") end); practice.AnchorPoint=Vector2.new(0,1); practice.Position=UDim2.new(0,16,1,-16)
local opener=UI.button(gui,"Menu",16,16,88,48,function() open("Settings") end)
local notice=UI.text(home,"M to explore the lobby",0,0,0,24,13); notice.Size=UDim2.new(1,-32,0,24); notice.Position=UDim2.new(.5,0,1,-24); notice.AnchorPoint=Vector2.new(.5,1); notice.TextXAlignment=Enum.TextXAlignment.Center; notice.TextColor3=C.panel
refresh=function()
 local queued=player:GetAttribute("RiftQueued")==true
 local phase=player:GetAttribute("RiftDuelPhase")
 local size=queued and (player:GetAttribute("RiftQueueSize") or mode) or mode
 local count=workspace:GetAttribute("RiftQueueCount"..size) or 0
 local caption=queued and "Leave queue" or (phase and "Match in progress" or "Find match")
 join.Text=caption
 join.Active=player:GetAttribute("RiftMap")=="Lobby" and not phase
