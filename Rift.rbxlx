			<Item class="LocalScript" referent="RBX16d85fa08c0045329992c753b41ef5b4">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local P=game.Players.LocalPlayer
local R=game.ReplicatedStorage:WaitForChild("RiftAction")
local U=game:GetService("UserInputService")
local Run=game:GetService("RunService")
local T=game:GetService("TweenService")
local D=game:GetService("Debris")
local gui=Instance.new("ScreenGui"); gui.Name="RiftHUD"; gui.ResetOnSpawn=false; gui.IgnoreGuiInset=true; gui.Parent=P:WaitForChild("PlayerGui")
local function label(size,pos,anchor,caption,fontSize)
 local l=Instance.new("TextLabel"); l.Size=size; l.Position=pos; l.AnchorPoint=anchor
 l.BackgroundColor3=Color3.fromRGB(17,24,38); l.BackgroundTransparency=.23
 l.TextColor3=Color3.fromRGB(224,245,255); l.Font=Enum.Font.GothamBold; l.TextSize=fontSize
 l.Text=caption; l.Parent=gui; return l
end
local function bar(w,h,x,y)
 local f=Instance.new("Frame"); f.BorderSizePixel=0; f.Size=UDim2.fromOffset(w,h); f.Position=UDim2.new(.5,x,.5,y); f.AnchorPoint=Vector2.new(.5,.5); f.BackgroundColor3=Color3.fromRGB(130,255,226); f.Parent=gui; return f
end
local cross={bar(2,7,0,-8),bar(2,7,0,8),bar(7,2,-8,0),bar(7,2,8,0)}
for _,f in cross do local s=Instance.new("UIScale"); s.Parent=f end
label(UDim2.fromOffset(220,38),UDim2.new(.5,0,0,22),Vector2.new(.5,0),"RIFT  /  LIVE FIRE",16)
local ammo=label(UDim2.fromOffset(158,50),UDim2.new(1,-24,1,-26),Vector2.one,"25  /  25",24)
local health=label(UDim2.fromOffset(140,50),UDim2.new(0,24,1,-26),Vector2.new(0,1),"100 HP",21)
local keys={Q="smoke",E="flash",F="recon"}
local slots={}
for i,key in {"Q","E","F"} do
 slots[keys[key]]=label(UDim2.fromOffset(112,44),UDim2.new(.5,(i-2)*119,1,-26),Vector2.new(.5,1),"",14)
end
local overlay=Instance.new("Frame"); overlay.Size=UDim2.fromScale(1,1); overlay.BackgroundColor3=Color3.fromRGB(255,251,226); overlay.BackgroundTransparency=1; overlay.ZIndex=10; overlay.Parent=gui
local fog=overlay:Clone(); fog.BackgroundColor3=Color3.fromRGB(62,43,88); fog.ZIndex=9; fog.Parent=gui
local clouds={}
local view=Instance.new("Model"); view.Name="RiftView"
local function gun(size,offset,color)
 local p=Instance.new("Part"); p.Size=size; p.Color=color; p.Material=Enum.Material.Metal
 p.Anchored=true; p.CanCollide=false; p.CanQuery=false; p.CanTouch=false; p.CastShadow=false
 p.Parent=view; p:SetAttribute("Offset",offset)
end
local steel=Color3.fromRGB(47,55,65)
local polymer=Color3.fromRGB(24,30,39)
local accent=Color3.fromRGB(101,206,182)
gun(Vector3.new(.32,.34,.87),Vector3.new(0,0,0),steel)
gun(Vector3.new(.3,.28,.82),Vector3.new(0,.02,-.8),polymer)
gun(Vector3.new(.12,.12,.47),Vector3.new(0,.03,-1.43),steel)
gun(Vector3.new(.19,.19,.2),Vector3.new(0,.03,-1.7),polymer)
gun(Vector3.new(.25,.27,.64),Vector3.new(0,-.02,.71),polymer)
gun(Vector3.new(.29,.46,.09),Vector3.new(0,-.04,1.06),steel)
gun(Vector3.new(.2,.44,.28),Vector3.new(0,-.34,-.24),polymer)
gun(Vector3.new(.19,.35,.2),Vector3.new(0,-.29,.28),polymer)
gun(Vector3.new(.22,.045,.35),Vector3.new(0,-.32,.07),steel)
gun(Vector3.new(.23,.05,1.5),Vector3.new(0,.205,-.4),steel)
gun(Vector3.new(.04,.2,.12),Vector3.new(-.09,.3,.2),polymer)
gun(Vector3.new(.04,.2,.12),Vector3.new(.09,.3,.2),polymer)
gun(Vector3.new(.22,.04,.12),Vector3.new(0,.41,.2),steel)
gun(Vector3.new(.04,.18,.08),Vector3.new(0,.3,-1.05),accent)
for i=1,8 do
 gun(Vector3.new(.34,.04,.045),Vector3.new(0,.1,-.43-i*.085),steel)
end
for _,x in {-1,1} do
 gun(Vector3.new(.018,.055,.45),Vector3.new(x*.165,.02,-.05),accent)
 gun(Vector3.new(.025,.07,.12),Vector3.new(x*.17,-.04,-.25),polymer)
end
gun(Vector3.new(.25,.21,.37),Vector3.new(.08,-.39,.3),Color3.fromRGB(65,72,78))
gun(Vector3.new(.27,.2,.42),Vector3.new(-.05,-.19,-.8),Color3.fromRGB(65,72,78))
local ready={}; local held=false; local nextShot=0; local kick=0; local rounds=25; local reloading=false; local hitAt=0; local flashTween
local function request(action)
 local cam=workspace.CurrentCamera
 if cam then R:FireServer(action,cam.CFrame.LookVector) end
end
U.InputBegan:Connect(function(input,processed)
 if processed or P:GetAttribute("RiftMenuOpen") or P:GetAttribute("RiftMap")=="Lobby" then return end
 if input.UserInputType==Enum.UserInputType.MouseButton1 then held=true; nextShot=0 end
 if input.KeyCode==Enum.KeyCode.R then request("reload") end
 local action=keys[input.KeyCode.Name]
 if action and (ready[action] or 0)<=os.clock() then request(action) end
end)
U.InputEnded:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 then held=false end end)
U.WindowFocusReleased:Connect(function() held=false end)
P.CharacterAdded:Connect(function() table.clear(ready); rounds=25; reloading=false; held=false end)
R.OnClientEvent:Connect(function(event,a,b)
 if event=="combatReset" then
  table.clear(ready); rounds=a; reloading=false; held=false
 elseif event=="ammo" then rounds=a; reloading=false
 elseif event=="reload" then reloading=true
 elseif event=="hit" then hitAt=os.clock()+.13
 elseif event=="cooldown" then ready[a]=os.clock()+b
 elseif event=="smoke" and a then table.insert(clouds,a)
 elseif event=="flash" then
  local cam=workspace.CurrentCamera
  local delta=a-cam.CFrame.Position
  if delta.Magnitude<.1 or cam.CFrame.LookVector:Dot(delta.Unit)>.35 then
   if flashTween then flashTween:Cancel() end
   overlay.BackgroundTransparency=.02
   flashTween=T:Create(overlay,TweenInfo.new(1.7,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{BackgroundTransparency=1}); flashTween:Play()
  end
 elseif event=="reveal" and a then
  local h=Instance.new("Highlight"); h.Adornee=a; h.FillColor=Color3.fromRGB(255,98,104); h.OutlineColor=Color3.new(1,1,1); h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop; h.Parent=a; D:AddItem(h,2.5)
 end
end)
Run:BindToRenderStep("RiftHUD",Enum.RenderPriority.Camera.Value+1,function(dt)
 local now=os.clock()
 for _,f in cross do f.UIScale.Scale=P:GetAttribute("RiftCrosshair") or 1 end
 local cam=workspace.CurrentCamera
 local hum=P.Character and P.Character:FindFirstChildOfClass("Humanoid")
 local inLobby=P:GetAttribute("RiftMap")=="Lobby"
 gui.Enabled=not inLobby
 local alive=hum and hum.Health>0 and not inLobby
 if P:GetAttribute("RiftMenuOpen") then held=false end
 health.Text=string.format("%d HP",hum and math.ceil(hum.Health) or 0)
 ammo.Text=reloading and "RELOADING" or string.format("%02d  /  25",rounds)
 for key,action in keys do
  local seconds=math.ceil((ready[action] or 0)-now)
  slots[action].Text=key.."  "..string.upper(action)..(seconds>0 and ("  "..seconds.."s") or "")
 end
 for _,f in cross do f.BackgroundColor3=now<hitAt and Color3.fromRGB(255,98,104) or Color3.fromRGB(130,255,226) end
 if not cam then return end
 local inside=false
 for i=#clouds,1,-1 do
  local cloud=clouds[i]
  if not cloud.Parent then table.remove(clouds,i)
  elseif (cloud.Position-cam.CFrame.Position).Magnitude<11 then inside=true end
 end
 fog.BackgroundTransparency=inside and .04 or 1
 view.Parent=alive and not P:GetAttribute("RiftMenuOpen") and cam or nil
 if not alive then return end
 if held and now>=nextShot and rounds>0 and not reloading then
  nextShot=now+.12; kick=.14; request("fire")
 end
 kick=math.max(0,kick-dt*1.8)
 local base=cam.CFrame*CFrame.new(.52,reloading and -.95 or -.52,-1.45+kick)
 for _,p in view:GetChildren() do p.CFrame=base*CFrame.new(p:GetAttribute("Offset")) end
end)]]></ProtectedString>
					<bool name="Disabled">false</bool>
