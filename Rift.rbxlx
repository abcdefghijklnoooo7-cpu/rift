			<Item class="LocalScript" referent="RBXd9389c6f99fa44b293cea5f31d89325e">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local player = game.Players.LocalPlayer
local queue = game.ReplicatedStorage:WaitForChild("RiftQueue")
local input = game:GetService("UserInputService")
local run = game:GetService("RunService")
local gui = Instance.new("ScreenGui")
gui.Name = "RiftDuelHUD"
gui.DisplayOrder = 5
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local banner = Instance.new("TextLabel")
banner.Name = "DuelStatus"
banner.AnchorPoint = Vector2.new(.5, 0)
banner.Position = UDim2.new(.5, 0, 0, 70)
banner.Size = UDim2.new(.88, 0, 0, 65)
banner.BackgroundColor3 = Color3.fromRGB(20,29,38)
banner.BackgroundTransparency = .12
banner.TextColor3 = Color3.fromRGB(187,251,229)
banner.Font = Enum.Font.GothamBold
banner.TextSize = 17
banner.TextWrapped = true
banner.Parent = gui
local width = Instance.new("UISizeConstraint")
width.MaxSize = Vector2.new(470, 65)
width.Parent = banner
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 6)
corner.Parent = banner

input.InputBegan:Connect(function(key, processed)
 if not processed and key.KeyCode == Enum.KeyCode.J and not player:GetAttribute("RiftMenuOpen") then
  queue:FireServer()
 end
end)

run.RenderStepped:Connect(function()
 local phase = player:GetAttribute("RiftDuelPhase")
 local lobby = player:GetAttribute("RiftMap") == "Lobby"
 banner.Visible = (lobby or phase ~= nil) and not player:GetAttribute("RiftMenuOpen")
 if not banner.Visible then return end
 if phase then
  local map = player:GetAttribute("RiftDuelArena") or "Duel"
  local score = player:GetAttribute("RiftDuelScore") or "0 – 0"
  local message = player:GetAttribute("RiftDuelMessage") or ""
  local deadline = player:GetAttribute("RiftDuelDeadline") or 0
  local seconds = math.max(0, math.ceil(deadline-workspace:GetServerTimeNow()))
  local suffix = ""
  if phase == "Fight" then suffix = string.format("  /  %d:%02d", math.floor(seconds/60), seconds%60) end
  if phase == "Countdown" then suffix = "  /  Starts in " .. seconds end
  if phase == "Finished" then suffix = "  /  Lobby in " .. seconds end
  banner.Text = map:upper() .. "   •   " .. score .. "\n" .. message .. suffix
 elseif player:GetAttribute("RiftQueued") then
  banner.Text = "1V1 QUEUE   •   WAITING FOR OPPONENT\nJ to leave the queue"
 else
  banner.Text = "RIFT LOBBY   /   FIRST TO 3\nJ to queue   •   M for settings and practice"
 end
end)
]]></ProtectedString>
