			<Item class="LocalScript" referent="RBX8b07206dbd0d40f59204129fe7f57356">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local player=game.Players.LocalPlayer
local input=game:GetService("UserInputService")
local run=game:GetService("RunService")
local remote=game.ReplicatedStorage:WaitForChild("RiftTravel")
local gui=Instance.new("ScreenGui")
gui.Name="RiftSettings"; gui.ResetOnSpawn=false; gui.DisplayOrder=30; gui.Parent=player:WaitForChild("PlayerGui")
local panel=Instance.new("Frame")
panel.Size=UDim2.fromOffset(560,440); panel.AnchorPoint=Vector2.new(.5,.5); panel.Position=UDim2.fromScale(.5,.5)
panel.BackgroundColor3=Color3.fromRGB(19,25,35); panel.Visible=false; panel.Parent=gui
local scale=Instance.new("UIScale"); scale.Parent=panel
local function text(caption,x,y,w,h,parent)
 local l=Instance.new("TextLabel"); l.Text=caption; l.Position=UDim2.fromOffset(x,y); l.Size=UDim2.fromOffset(w,h); l.BackgroundTransparency=1
 l.TextColor3=Color3.fromRGB(225,235,242); l.Font=Enum.Font.GothamBold; l.TextSize=16; l.Parent=parent or panel; return l
end
local function button(caption,x,y,w,h,callback,parent)
 local b=Instance.new("TextButton"); b.Text=caption; b.Position=UDim2.fromOffset(x,y); b.Size=UDim2.fromOffset(w,h)
 b.BackgroundColor3=Color3.fromRGB(43,66,77); b.TextColor3=Color3.fromRGB(220,255,243); b.Font=Enum.Font.GothamBold; b.TextSize=14; b.Parent=parent or panel
 b.Activated:Connect(callback); return b
end
local function toggle()
 panel.Visible=not panel.Visible; player:SetAttribute("RiftMenuOpen",panel.Visible)
end
local opener=button("SETTINGS / MAPS  [M]",18,65,210,34,toggle,gui)
local close=button("CLOSE  [M]",414,14,130,34,toggle); close.Modal=true
text("RIFT / PLAYER SETTINGS",18,14,310,34)
text("Changes apply immediately. Saved for this session.",18,54,520,28).TextSize=13
local function setting(title,attribute,default,min,max,step,y)
 local value=default
 player:SetAttribute(attribute,value)
 text(title,22,y,220,36).TextXAlignment=Enum.TextXAlignment.Left
 local valueLabel=text("",300,y,100,36)
 local function update(delta)
  value=math.clamp(math.round((value+delta)/step)*step,min,max)
  player:SetAttribute(attribute,value); valueLabel.Text=string.format(attribute=="RiftFOV" and "%.0f" or "%.2fx",value)
 end
 button("−",256,y,38,36,function() update(-step) end)
 button("+",410,y,38,36,function() update(step) end)
 update(0)
end
setting("Mouse sensitivity", "RiftSensitivity",1,.1,3,.1,96)
setting("Field of view", "RiftFOV",80,60,110,5,142)
setting("Crosshair size", "RiftCrosshair",1,.5,2,.25,188)
text("PRACTICE MAPS",18,245,520,30)
local choices={"Training Arena","Pine Ridge","Red Mesa","Metro District","Dockyard","Lobby"}
for i,name in choices do
 local row=math.floor((i-1)/3); local column=(i-1)%3
 button(name,18+column*178,284+row*48,168,40,function()
  if player:GetAttribute("RiftDuelId") or player:GetAttribute("RiftQueued") then return end
  remote:FireServer(name)
  toggle()
 end)
end
text("WASD move · Mouse fire · R reload · Q/E/F abilities",18,393,520,26).TextSize=12
input.InputBegan:Connect(function(key,processed) if not processed and key.KeyCode==Enum.KeyCode.M then toggle() end end)
run:BindToRenderStep("RiftSettings",Enum.RenderPriority.Camera.Value+2,function()
 local camera=workspace.CurrentCamera
 if camera then
  camera.FieldOfView=player:GetAttribute("RiftFOV") or 80
  scale.Scale=math.min(1,(camera.ViewportSize.X-30)/560,(camera.ViewportSize.Y-40)/440)
 end
 input.MouseDeltaSensitivity=panel.Visible and 0 or (player:GetAttribute("RiftSensitivity") or 1)
 if panel.Visible then input.MouseBehavior=Enum.MouseBehavior.Default; input.MouseIconEnabled=true else input.MouseIconEnabled=false end
end)
]]></ProtectedString>
