home=UI.frame(gui,"LobbyInterface",0,0,0,0); home.Size=UDim2.fromScale(1,1); home.BackgroundTransparency=1
local dock=UI.frame(home,"Navigation",16,0,112,224); dock.AnchorPoint=Vector2.new(0,.5); dock.Position=UDim2.new(0,16,.5,0); dock.BackgroundTransparency=1
for i,item in {{"⌂","Play"},{"◇","Arsenal"},{"↗","Abilities"},{"⚙","Settings"}} do
