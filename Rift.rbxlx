   tube("Handle core",shaft,.13,0,0,-shaft*.3,paint)
   for i=0,7 do tube("Wrapped handle band",.06,.17,0,0,.25-i*.09,rubber) end
   tube("Pommel",.1,.2,0,0,.35,trim)
