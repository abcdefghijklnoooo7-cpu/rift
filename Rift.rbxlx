	<Item class="ModuleScript" referent="RIFT_UI_RiftTheme"><Properties><string name="Name">RiftTheme</string><ProtectedString name="Source">-- The only six UI color tokens. World and weapon materials are independent.
return table.freeze({
 background=Color3.fromRGB(26,37,48),
 panel=Color3.fromRGB(242,245,243),
 text=Color3.fromRGB(31,47,56),
 accent=Color3.fromRGB(30,112,130),
 success=Color3.fromRGB(56,130,97),
 danger=Color3.fromRGB(190,64,64),
})
</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RIFT_UI_RiftUIController"><Properties><string name="Name">RiftUIController</string><ProtectedString name="Source">-- One owner arbitrates modals, including match voting and the scoreboard.
local Tween=game:GetService("TweenService")
local Controller={screens={},active=nil}
function Controller:Register(name,view,priority,changed)
 assert(not self.screens[name],"Duplicate UI screen: "..name)
 self.screens[name]={view=view,priority=priority or 0,wanted=false,changed=changed}
 view.Visible=false
end
function Controller:Set(name,wanted)
 local screen=assert(self.screens[name],"Unknown UI screen: "..name)
 if screen.wanted==wanted then return end
 screen.wanted=wanted
 local best,bestPriority=nil,-math.huge
 for key,item in self.screens do
  if item.wanted and item.priority&gt;bestPriority then best,bestPriority=key,item.priority end
 end
 if self.active==best then return end
 self.active=best
 for key,item in self.screens do
  local visible=key==best
  item.view.Interactable=visible
  if item.tween then item.tween:Cancel(); item.tween=nil end
  item.generation=(item.generation or 0)+1
  local generation=item.generation
  if item.view:IsA("CanvasGroup") then
   if visible then item.view.Visible=true; item.view.GroupTransparency=1 end
   item.tween=Tween:Create(item.view,TweenInfo.new(.2,Enum.EasingStyle.Quad),{GroupTransparency=visible and 0 or 1})
   item.tween:Play()
   if not visible then task.delay(.2,function() if item.generation==generation then item.view.Visible=false end end) end
  else item.view.Visible=visible end
  if item.changed then item.changed(visible) end
 end
 game.Players.LocalPlayer:SetAttribute("RiftModalOpen",best)
end
return Controller
</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RIFT_UI_RiftAudio"><Properties><string name="Name">RiftAudio</string><ProtectedString name="Source">-- Client audio: independent effects/music buses and action-driven cues.
local Audio={}
local service=game:GetService("SoundService")
local player=game.Players.LocalPlayer
local Tween=game:GetService("TweenService")
local Debris=game:GetService("Debris")
Audio.Effects=service:FindFirstChild("RiftEffects") or Instance.new("SoundGroup")
Audio.Effects.Name="RiftEffects"; Audio.Effects.Parent=service
local musicBus=Instance.new("SoundGroup"); musicBus.Name="RiftMusic"; musicBus.Parent=service
local function volume()
 Audio.Effects.Volume=player:GetAttribute("RiftVolume") or 1
 musicBus.Volume=player:GetAttribute("RiftMusicVolume") or .5
end
player:GetAttributeChangedSignal("RiftVolume"):Connect(volume)
player:GetAttributeChangedSignal("RiftMusicVolume"):Connect(volume); volume()
local sources={
 equip={"rbxassetid://9120409666",.18,1.6},
 reloadEnd={"rbxassetid://9120409666",.12,1.9},
 dash={"rbxasset://sounds/action_jump.mp3",.2,1.5},
 slide={"rbxasset://sounds/action_footsteps_plastic.mp3",.15,.85},
 land={"rbxasset://sounds/action_footsteps_plastic.mp3",.13,.7},
 hurt={"rbxasset://sounds/impact_water.mp3",.1,1.8},
 round={"rbxasset://sounds/volume_slider.ogg",.16,1.7},
 queue={"rbxasset://sounds/volume_slider.ogg",.1,1.3},
}
local templates={}
for name,data in sources do
 local s=Instance.new("Sound"); s.Name="RiftCue_"..name; s.SoundId=data[1]; s.Volume=data[2]; s.PlaybackSpeed=data[3]; s.SoundGroup=Audio.Effects; s.Parent=service; templates[name]=s
end
function Audio.Play(name)
 local template=templates[name]; if not template then return end
 local s=template:Clone(); s.Parent=service; s:Play(); Debris:AddItem(s,4)
end
local music=Instance.new("Sound"); music.Name="RiftLobbyMusic"; music.SoundId="rbxassetid://9042295159"; music.Looped=true; music.Volume=0; music.SoundGroup=musicBus; music.Parent=service
local fade,generation
local function lobbyMusic()
 generation=(generation or 0)+1; local current=generation
 local lobby=player:GetAttribute("RiftMap")=="Lobby" and not player:GetAttribute("RiftDuelPhase")
 if fade then fade:Cancel() end
 if lobby and not music.IsPlaying then music:Play() end
 fade=Tween:Create(music,TweenInfo.new(.7,Enum.EasingStyle.Quad),{Volume=lobby and .22 or 0}); fade:Play()
 if not lobby then task.delay(.7,function() if generation==current then music:Pause() end end) end
end
player:GetAttributeChangedSignal("RiftMap"):Connect(lobbyMusic)
player:GetAttributeChangedSignal("RiftDuelPhase"):Connect(function()
 local phase=player:GetAttribute("RiftDuelPhase")
 if phase=="Countdown" or phase=="Fight" then Audio.Play("round") end
 lobbyMusic()
end)
player:GetAttributeChangedSignal("RiftQueued"):Connect(function() Audio.Play("queue") end)
lobbyMusic()
task.spawn(function()
 local preload={music}; for _,s in templates do table.insert(preload,s) end
 pcall(function() game:GetService("ContentProvider"):PreloadAsync(preload) end)
end)
return Audio
</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RIFT_ITEMS_MODULE"><Properties><string name="Name">RiftItems</string><ProtectedString name="Source">local Items={}
local Debris=game:GetService("Debris")
local Players=game:GetService("Players")
function Items.Use(x,alt)
 local w,p,s=x.weapon,x.player,x.state
 local root=x.character:FindFirstChild("HumanoidRootPart")
 if not root then return end
 local function targets(position,radius,callback)
  local seen={}
  for _,part in workspace:GetPartBoundsInRadius(position,radius) do
   local model=part:FindFirstAncestorOfClass("Model")
   if model and not seen[model] and model~=x.character then
    seen[model]=true
    local hum=model:FindFirstChildOfClass("Humanoid"); local r=model:FindFirstChild("HumanoidRootPart")
    local other=Players:GetPlayerFromCharacter(model)
    if hum and r and hum.Health&gt;0 and ((other and x.enemy(p,other)) or (not p:GetAttribute("RiftDuelId") and model.Parent==workspace.RiftArena.Targets)) then
     local delta=r.Position-position; local hit=workspace:Raycast(position,delta,x.params)
     if not hit or hit.Instance:IsDescendantOf(model) then callback(model,hum,r,other) end
    end
   end
  end
 end
 local function boost(direction,power)
  root.AssemblyLinearVelocity=direction*power+Vector3.new(0,28,0)
 end
 local function block(position,size,color,life)
  local part=x.effect(x.parent,position,size,color,0,life,false); part.Name=w.name; return part
 end
 local function area(position,amount,radius)
  x.blast(p,x.parent,position,{bodyDamage=amount,blastRadius=radius})
 end
 local function impact(position)
  if not x.valid() then return end
  if w.name=="Smoke Grenade" then
   local cloud=x.effect(x.parent,position,Vector3.one*22,Color3.fromRGB(75,83,91),.15,9,true)
   x.remote:FireAllClients("smoke",cloud)
  elseif w.name=="Flashbang" then
   x.effect(x.parent,position,Vector3.one*4,Color3.new(1,1,1),.15,.3,true)
   for _,other in Players:GetPlayers() do
    local head=other.Character and other.Character:FindFirstChild("Head")
    if head and x.enemy(p,other) and (head.Position-position).Magnitude&lt;55 then
     local ray=workspace:Raycast(position,head.Position-position,x.params)
     if not ray or ray.Instance:IsDescendantOf(other.Character) then x.remote:FireClient(other,"flash",position) end
    end
   end
  elseif w.name=="Molotov" then
   local fire=block(position,Vector3.new(16,.3,16),Color3.fromRGB(235,115,42),6)
   task.spawn(function() for _=1,12 do if not x.valid() or not fire.Parent then break end; targets(position,9,function(model) x.damage(p,model,8,false,position) end); task.wait(.5) end end)
  else area(position,w.bodyDamage,w.blastRadius or 13) end
 end
 local hit=workspace:Raycast(x.origin,x.aim*(w.range or 60),x.params)
 local point=hit and hit.Position+hit.Normal*.8 or x.origin+x.aim*(w.range or 60)
 if alt then
  if w.name=="Fists" then
   if x.humanoid.FloorMaterial==Enum.Material.Air and not s.airJumpUsed then s.airJumpUsed=true; root.AssemblyLinearVelocity=Vector3.new(root.AssemblyLinearVelocity.X,48,root.AssemblyLinearVelocity.Z) end
  elseif w.name=="Katana" or w.name=="Riot Shield" then p:SetAttribute("RiftGuardUntil",os.clock()+1.2); p:SetAttribute("RiftGuardReflect",w.name=="Katana")
  elseif w.name=="Trowel" then local wall=block(root.Position+root.CFrame.LookVector*6,Vector3.new(9,7,1),Color3.fromRGB(125,113,94),8); wall.CanCollide=true; wall.CanQuery=true
  elseif w.name=="Spear" then local thrown=workspace:Raycast(x.origin,x.aim*90,x.params); if thrown then x.damage(p,thrown.Instance:FindFirstAncestorOfClass("Model"),45,false,x.origin) end
  elseif w.name=="Maul" then x.effect(x.parent,root.Position,Vector3.new(20,.3,20),Color3.fromRGB(145,128,100),.5,.3,false); targets(root.Position,12,function(model) x.damage(p,model,35,false,root.Position) end)
  elseif w.name=="Satchel" then if s.satchel and s.satchel.Parent then local pos=s.satchel.Position; s.satchel:Destroy(); s.satchel=nil; area(pos,55,14) end
  elseif w.name=="Warper" then
   if s.portal and s.portal.Parent then
    local first=s.portal; s.portal=nil
    local second=block(point,Vector3.new(5,.3,5),Color3.fromRGB(90,160,170),12)
    local last={}
    for _,pair in {{first,second},{second,first}} do pair[1].CanTouch=true; pair[1].Touched:Connect(function(part)
     local character=part:FindFirstAncestorOfClass("Model"); local other=character and Players:GetPlayerFromCharacter(character)
     if x.valid() and other and x.ally(p,other) and pair[2].Parent and os.clock()-(last[other] or 0)&gt;1 then last[other]=os.clock(); character:PivotTo(CFrame.new(pair[2].Position+Vector3.new(0,4,0))) end
    end) end
   end
  else boost(x.aim,w.name=="Chainsaw" and 58 or 44) end
  return
 end
 if w.melee then
  targets(x.origin,w.range,function(model,hum,r)
   local delta=r.Position-x.origin
   if delta.Magnitude&lt;.01 or x.aim:Dot(delta.Unit)&gt;.35 then
    local amount=w.bodyDamage
    if w.name=="Knife" and r.CFrame.LookVector:Dot((root.Position-r.Position).Unit)&lt;-.5 then amount*=2 end
    x.damage(p,model,amount,false,x.origin)
    if w.name=="Maul" or w.name=="Battle Axe" or w.name=="Riot Shield" then r.AssemblyLinearVelocity+=x.aim*35+Vector3.new(0,12,0) end
   end
  end)
 elseif w.name=="Medkit" or w.name=="Elixir" then
  x.humanoid.Health=math.min(x.humanoid.MaxHealth,x.humanoid.Health+(w.name=="Medkit" and 70 or 35))
  if w.name=="Elixir" then boost(x.aim,35) end
 elseif w.name=="Warpstone" then
  if hit then
   local destination=point+Vector3.new(0,3,0)
   local clear=OverlapParams.new(); clear.FilterType=Enum.RaycastFilterType.Exclude; clear.FilterDescendantsInstances={x.character}
   local safe=true; for _,part in workspace:GetPartBoundsInBox(CFrame.new(destination),Vector3.new(3,5,3),clear) do if part.CanCollide then safe=false; break end end
   if safe then x.character:PivotTo(CFrame.lookAt(destination,destination+x.aim)) end
  end
 elseif w.name=="Grappler" then if hit then boost((point-root.Position).Unit,65) end
 elseif w.name=="War Horn" then
  for _,other in Players:GetPlayers() do
   local r=other.Character and other.Character:FindFirstChild("HumanoidRootPart")
   if r and x.ally(p,other) and (r.Position-root.Position).Magnitude&lt;30 then other:SetAttribute("RiftEmpoweredUntil",os.clock()+6) end
  end
 elseif w.name=="Freeze Ray" then
  local length=(point-x.origin).Magnitude; if length&gt;.1 then local beam=block((point+x.origin)*.5,Vector3.new(.12,.12,length),Color3.fromRGB(120,210,230),.15);beam.CFrame=CFrame.lookAt((point+x.origin)*.5,point) end
  if hit then
   local model=hit.Instance:FindFirstAncestorOfClass("Model"); x.damage(p,model,5,false,x.origin)
   targets(point,2,function(_,hum,r) r.AssemblyLinearVelocity*=.25; hum:SetAttribute("RiftFrozenUntil",os.clock()+1.5) end)
  end
 elseif w.name=="Jump Pad" then
  local pad=block(root.Position+root.CFrame.LookVector*5-Vector3.new(0,2.5,0),Vector3.new(6,.4,6),Color3.fromRGB(73,151,159),15)
  pad.CanCollide=true; pad.CanTouch=true; local last={}
  pad.Touched:Connect(function(part) local model=part:FindFirstAncestorOfClass("Model"); local other=model and Players:GetPlayerFromCharacter(model); local r=model and model:FindFirstChild("HumanoidRootPart")
   if x.valid() and other and r and x.ally(p,other) and os.clock()-(last[other] or 0)&gt;.8 then last[other]=os.clock(); r.AssemblyLinearVelocity=Vector3.new(r.AssemblyLinearVelocity.X,75,r.AssemblyLinearVelocity.Z) end
  end)
 elseif w.name=="Satchel" or w.name=="Subspace Tripmine" or w.name=="Warper" then
  local device=block(point,Vector3.new(2,.4,2),Color3.fromRGB(120,146,136),20)
  if w.name=="Satchel" then s.satchel=device
  elseif w.name=="Warper" then s.portal=device
  else task.spawn(function() task.wait(.8); while device.Parent and x.valid() do local found=false; targets(device.Position,7,function() found=true end); if found then local pos=device.Position; device:Destroy(); area(pos,50,13); break end; task.wait(.2) end end) end
 elseif w.name=="RNG Dice" then
  local roll=math.random(1,3); if roll==1 then x.humanoid.Health=math.min(100,x.humanoid.Health+25) elseif roll==2 then boost(x.aim,45) else impact(point) end
 else
  local ball=block(x.origin+x.aim*2,Vector3.one*.6,Color3.fromRGB(86,116,82),4); ball.Shape=Enum.PartType.Ball; ball.Anchored=false; ball.CanCollide=true; ball.CanQuery=false; ball:SetNetworkOwner(nil); ball.AssemblyLinearVelocity=x.aim*60+Vector3.new(0,20,0)
  task.delay(w.name=="Molotov" and 1 or 2.5,function() if ball.Parent then local pos=ball.Position; ball:Destroy(); impact(pos) end end)
 end
end
return Items
</ProtectedString></Properties></Item></Item>
	<Item class="ServerScriptService" referent="RBX25e400ec60334f34bcfd868bbdaea316">
		<Properties>
			<bool name="LoadStringEnabled">false</bool>
			<BinaryString name="AttributesSerialize"></BinaryString>
			<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
			<bool name="DefinesCapabilities">false</bool>
			<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
			<string name="Name">ServerScriptService</string>
			<BinaryString name="SerializedOverrides"></BinaryString>
			<int64 name="SourceAssetId">-1</int64>
			<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
			<UniqueId name="UniqueId">3c83a70e7eb853630afca5dc000003c0</UniqueId>
		</Properties>
		<Item class="BindableEvent" referent="RBXc2c05f635be94ff594627f9bc10185fa">
			<Properties>
				<string name="Name">RiftElimination</string>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX9f790212876c4f6ea9d242533b8a5177">
			<Properties>
				<string name="Name">RiftMovement</string>
				<bool name="Disabled">false</bool>
				<ProtectedString name="Source">local players=game:GetService("Players")
local run=game:GetService("RunService")
local remote=game.ReplicatedStorage.RiftAction
local reset=script.Parent.RiftResetCombat
local states={}
local features={}
local motionTokens={}

local function launch(root,impulse)
 if not root:CanSetNetworkOwnership() then return end
 local token={}
 motionTokens[root]=token
 root:SetNetworkOwner(nil)
 root:ApplyImpulse(impulse*root.AssemblyMass)
 task.delay(.24,function()
  if motionTokens[root]~=token then return end
  motionTokens[root]=nil
  if root.Parent and root:CanSetNetworkOwnership() then root:SetNetworkOwnershipAuto() end
 end)
end

local function makePart(parent,name,size,position,color,material)
 local part=Instance.new("Part")
 part.Name=name
 part.Anchored=true
 part.Size=size
 part.Position=position
 part.Color=color
 part.Material=material
 part.Parent=parent
 return part
end

local function addFeatures(map,mapName,center,duel)
 local folder=Instance.new("Folder")
 folder.Name="ArenaFeatures"
 folder.Parent=map
 local function place(name,size,position,color,material)
  local offset=position-center
  return makePart(folder,name,Vector3.new(size.X*1.35,size.Y,size.Z*1.35),center+Vector3.new(offset.X*1.35,offset.Y,offset.Z*1.35),color,material)
 end
 local boosts={}
 local hazards={}
 features[mapName]={boosts=boosts,hazards=hazards}
 for _,side in {-1,1} do
  local padPosition=center+Vector3.new(side*31,.28,side*32)
  if mapName=="Training Arena" then padPosition=center+(side==1 and Vector3.new(74,.28,-7) or Vector3.new(86,.28,-77)) end
  if mapName=="Red Mesa" and side==-1 then padPosition=center+Vector3.new(-38,.28,-52) end
  local trampoline=place("Trampoline",Vector3.new(9,.55,9),padPosition,Color3.fromRGB(42,186,237),Enum.Material.Neon)
  table.insert(boosts,trampoline)
  local hazard=place("Live hazard",Vector3.new(9,.16,10),center+Vector3.new(mapName=="Training Arena" and -84 or side*(duel and 13 or 9),.13,side*20),Color3.fromRGB(247,89,33),Enum.Material.Neon)
  table.insert(hazards,hazard)
  if duel then
   local deckColor=side==1 and Color3.fromRGB(82,132,173) or Color3.fromRGB(173,111,79)
   place("Flank step",Vector3.new(5,2,6),center+Vector3.new(side*34,1,0),deckColor,Enum.Material.Concrete)
   place("Flank platform",Vector3.new(7,4,6),center+Vector3.new(side*40,2,0),deckColor,Enum.Material.Concrete)
  end
 end
end

addFeatures(workspace.RiftArena,"Training Arena",Vector3.new(0,10,0),false)
for _,map in workspace.RiftMaps:GetChildren() do
 local spawn=map:GetAttribute("Spawn")
 if spawn then addFeatures(map,map.Name,Vector3.new(spawn.X,10,0),false) end
end
for _,map in workspace.RiftDuels:GetChildren() do
 local spawn=map:GetAttribute("SpawnA")
 if spawn then addFeatures(map,map.Name,Vector3.new(spawn.X,10,0),true) end
end

local function resetPlayer(player)
 states[player]={stamina=100,sprint=false,exhausted=false,dashUntil=0,boostUntil=0,hazardUntil=0,recoverAt=0,slideUntil=0,slideReady=0}
 player:SetAttribute("RiftStamina",100)
 player:SetAttribute("RiftSprinting",false)
 player:SetAttribute("RiftSliding",false)
end

local function bind(player)
 resetPlayer(player)
 player.CharacterAdded:Connect(function() resetPlayer(player) end)
end
players.PlayerAdded:Connect(bind)
players.PlayerRemoving:Connect(function(player) states[player]=nil end)
for _,player in players:GetPlayers() do bind(player) end
reset.Event:Connect(resetPlayer)

local function activeMap(player)
 if player:GetAttribute("RiftDuelId") then
  if player:GetAttribute("RiftDuelPhase")=="Fight" and player:GetAttribute("RiftRoundAlive") then return player:GetAttribute("RiftDuelArena") end
  return nil
 end
 return player:GetAttribute("RiftMap")
end

remote.OnServerEvent:Connect(function(player,action,arg)
 if action~="sprint" and action~="dash" and action~="slide" then return end
 local state=states[player]
 if not state then return end
 if action=="sprint" and arg==false then state.sprint=false; return end
 local character=player.Character
 local humanoid=character and character:FindFirstChildOfClass("Humanoid")
 local root=character and character:FindFirstChild("HumanoidRootPart")
 if not features[activeMap(player) or ""] or not root or root.Anchored or not humanoid or humanoid.Health&lt;=0 then return end
 if action=="sprint" and arg==true then
  state.sprint=true
 elseif action=="dash" and state.stamina&gt;=30 and os.clock()&gt;=state.dashUntil then
  state.stamina-=30
  state.dashUntil=os.clock()+1.2
  state.recoverAt=os.clock()+.7
  local heading=root.CFrame.LookVector
  local flat=Vector3.new(heading.X,0,heading.Z)
  if flat.Magnitude&gt;.01 then launch(root,flat.Unit*46) end
  player:SetAttribute("RiftStamina",math.floor(state.stamina))
  remote:FireClient(player,"abilityCast","dash")
 elseif action=="slide" then
  local now=os.clock()
  local velocity=root.AssemblyLinearVelocity
  local horizontal=Vector3.new(velocity.X,0,velocity.Z)
  if not state.sprint or state.stamina&lt;16 or now&lt;state.slideReady or horizontal.Magnitude&lt;14 or humanoid.FloorMaterial==Enum.Material.Air then return end
  state.stamina-=16
  state.slideUntil=now+.48
  state.slideReady=now+1.2
  state.recoverAt=now+.65
  launch(root,horizontal.Unit*math.max(0,37-horizontal.Magnitude))
  player:SetAttribute("RiftSliding",true)
  remote:FireClient(player,"abilityCast","slide")
 end
end)

local function onPlate(root,plate,maxHeight)
 local offset=root.Position-plate.Position
 return math.abs(offset.X)&lt;plate.Size.X*.5 and math.abs(offset.Z)&lt;plate.Size.Z*.5 and offset.Y&gt;=0 and offset.Y&lt;maxHeight
end

local elapsed=0
run.Heartbeat:Connect(function(dt)
 elapsed+=dt
 if elapsed&lt;.1 then return end
 local step=math.min(elapsed,.25)
 elapsed=0
 local now=os.clock()
 for player,state in states do
  local character=player.Character
  local humanoid=character and character:FindFirstChildOfClass("Humanoid")
  local root=character and character:FindFirstChild("HumanoidRootPart")
  if not humanoid or humanoid.Health&lt;=0 or not root then continue end
  local region=features[activeMap(player) or ""]
  if state.stamina&lt;=0 then state.exhausted=true end
  if state.exhausted and state.stamina&gt;=30 then state.exhausted=false end
  local sliding=region~=nil and now&lt;state.slideUntil and not root.Anchored
  local sprint=region~=nil and state.sprint and not sliding and not state.exhausted and not root.Anchored
  local velocity=root.AssemblyLinearVelocity
  local moving=Vector3.new(velocity.X,0,velocity.Z).Magnitude&gt;2
  if sprint and moving then
   state.stamina=math.max(0,state.stamina-step*24)
   state.recoverAt=now+.45
  elseif not sprint and now&gt;=state.recoverAt then
   state.stamina=math.min(100,state.stamina+step*18)
  end
  local speed=sliding and 28 or (sprint and 25 or 17)
  if (humanoid:GetAttribute("RiftFrozenUntil") or 0)&gt;os.clock() then speed=math.min(speed,6) end
  if humanoid.WalkSpeed~=speed then humanoid.WalkSpeed=speed end
  player:SetAttribute("RiftStamina",math.floor(state.stamina))
  player:SetAttribute("RiftSprinting",sprint and moving)
  player:SetAttribute("RiftSliding",sliding)
  if not region or root.Anchored then continue end
  if now&gt;=state.boostUntil and velocity.Y&lt;10 then
   for _,pad in region.boosts do
    if onPlate(root,pad,4.8) then
     state.boostUntil=now+1.1
     launch(root,Vector3.new(0,66-velocity.Y,0))
     remote:FireClient(player,"abilityCast","bounce")
     break
    end
   end
  end
  if now&gt;=state.hazardUntil then
   for _,plate in region.hazards do
    if onPlate(root,plate,4.2) then
     state.hazardUntil=now+.75
     humanoid:TakeDamage(14)
     remote:FireClient(player,"damageFrom")
     break
    end
   end
  end
 end
end)
</ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX1905d88a65734d809f7cbb9edbc8e119">
			<Properties>
				<ProtectedString name="Source">local P=game:GetService("Players")
local R=game.ReplicatedStorage.RiftAction
local D=game:GetService("Debris")
local weapons=require(game.ReplicatedStorage.RiftWeapons)
local Items=require(game.ReplicatedStorage.RiftItems)
local eliminated=script.Parent.RiftElimination
local rng=Random.new()
local S={}
local function reset(p)
 local loadout,ammo={},{}
 for slot,definition in ipairs(weapons.Slots) do
  local id=weapons.GetId(p,slot); loadout[slot]=id; ammo[slot]=weapons[id].magazine
  if p:GetAttribute(definition.attribute)==nil then p:SetAttribute(definition.attribute,id) end
 end
 S[p]={
  equipped=1,
  loadout=loadout,
  ammo=ammo,
  nextShot=0,
  ready={},
  reload=nil,
 }
 R:FireClient(p,"combatReset")
end
script.Parent.RiftResetCombat.Event:Connect(reset)
local function setup(p)
 p.CameraMode=Enum.CameraMode.LockFirstPerson
 local function onCharacter(character)
  reset(p)
  p:SetAttribute("RiftGuardUntil",0); p:SetAttribute("RiftEmpoweredUntil",0)
  local humanoid=character:WaitForChild("Humanoid",5)
  if humanoid then
   humanoid.MaxHealth=100
   humanoid.Health=100
   humanoid.StateChanged:Connect(function(_,state) if state==Enum.HumanoidStateType.Landed and S[p] then S[p].airJumpUsed=false end end)
  end
 end
 p.CharacterAdded:Connect(onCharacter)
 if p.Character then task.spawn(onCharacter,p.Character) end
end

local function sameCombatSpace(a,b)
 local duel=a:GetAttribute("RiftDuelId")
 if duel then
  return b:GetAttribute("RiftDuelId")==duel and b:GetAttribute("RiftDuelPhase")=="Fight" and b:GetAttribute("RiftRoundAlive")==true
 end
 local map=a:GetAttribute("RiftMap")
 return map and map~="Lobby" and not b:GetAttribute("RiftDuelId") and b:GetAttribute("RiftMap")==map
end
P.PlayerAdded:Connect(setup)
P.PlayerRemoving:Connect(function(p) S[p]=nil end)
for _,p in P:GetPlayers() do setup(p) end
local function effect(parent,pos,size,color,alpha,life,ball)
 local part=Instance.new("Part")
 part.Name="AbilityEffect"; part.Anchored=true; part.CanCollide=false; part.CanTouch=false; part.CanQuery=false
 part.Shape=ball and Enum.PartType.Ball or Enum.PartType.Block
 part.Size=size; part.Position=pos; part.Color=color; part.Transparency=alpha; part.Material=Enum.Material.Neon
 part.Parent=parent; D:AddItem(part,life); return part
end
local function enemy(attacker,opponent)
 if not sameCombatSpace(attacker,opponent) then return false end
 return not attacker:GetAttribute("RiftDuelId") or attacker:GetAttribute("RiftTeam")~=opponent:GetAttribute("RiftTeam")
end

local function damage(attacker,model,amount,headshot,origin)
 if not model then return end
 local opponent=P:GetPlayerFromCharacter(model)
 if opponent then
  if opponent==attacker or not enemy(attacker,opponent) then return end
 elseif attacker:GetAttribute("RiftDuelId") or model.Parent~=workspace.RiftArena.Targets then
  return
 end
 local target=model:FindFirstChildOfClass("Humanoid")
 if not target or target.Health&lt;=0 then return end
 if attacker:GetAttribute("RiftEmpoweredUntil") and attacker:GetAttribute("RiftEmpoweredUntil")&gt;os.clock() then amount*=1.2 end
 if opponent and origin then
  local root=model:FindFirstChild("HumanoidRootPart")
  local direction=root and origin-root.Position
  local facing=direction and direction.Magnitude&gt;.01 and root.CFrame.LookVector:Dot(direction.Unit) or 0
  if (opponent:GetAttribute("RiftGuardUntil") or 0)&gt;os.clock() and facing&gt;.2 then
   if opponent:GetAttribute("RiftGuardReflect") then local h=attacker.Character and attacker.Character:FindFirstChildOfClass("Humanoid"); if h then h:TakeDamage(math.min(amount,35)) end end
   return
  end
  local state=S[opponent]
  if state and state.equipped~=3 and weapons[state.loadout[3]].name=="Riot Shield" and facing&lt;-.2 then amount*=.5 end
 end
 local before=target.Health
 target:TakeDamage(math.round(amount))
 local dealt=math.round(before-target.Health)
 if dealt&lt;=0 then return end
 local killed=target.Health&lt;=0
 R:FireClient(attacker,"hit",headshot,dealt,killed)
 if opponent then
  R:FireClient(opponent,"damageFrom",origin)
  if killed then eliminated:Fire(attacker,opponent) end
 end
end

local function trace(parent,origin,dest)
 local start=origin-Vector3.new(0,.55,0)
 local length=(dest-start).Magnitude
 if length&lt;.02 then return end
 local tracer=effect(parent,(start+dest)/2,Vector3.new(.055,.055,length),Color3.fromRGB(255,209,104),0,.065,false)
 tracer.CFrame=CFrame.lookAt(tracer.Position,dest)
end

local function aimWithSpread(aim,degrees)
 local cone=math.tan(math.rad(degrees))
 local angle=rng:NextNumber(0,math.pi*2)
 local radius=math.sqrt(rng:NextNumber())*cone
 local basis=CFrame.lookAt(Vector3.zero,aim)
 return (aim+basis.RightVector*(math.cos(angle)*radius)+basis.UpVector*(math.sin(angle)*radius)).Unit
end

local function blast(attacker,parent,position,weapon,directTarget)
 effect(parent,position,Vector3.one*weapon.blastRadius*2,Color3.fromRGB(255,159,68),.55,.18,true)
 local targets={}
 for _,player in P:GetPlayers() do
  if player.Character and sameCombatSpace(attacker,player) then
   R:FireClient(player,"explosion",position)
   if player~=attacker then table.insert(targets,player.Character) end
  end
 end
 if not attacker:GetAttribute("RiftDuelId") then
  for _,bot in workspace.RiftArena.Targets:GetChildren() do table.insert(targets,bot) end
 end
 local sight=RaycastParams.new()
 sight.FilterType=Enum.RaycastFilterType.Exclude
 sight.FilterDescendantsInstances={attacker.Character}
 for _,target in targets do
  local root=target:FindFirstChild("HumanoidRootPart")
  if not root then continue end
  local offset=root.Position-position
  if target~=directTarget and offset.Magnitude&gt;weapon.blastRadius then continue end
  local hit=workspace:Raycast(position,offset,sight)
  if target==directTarget or not hit or hit.Instance:IsDescendantOf(target) then
   local amount=target==directTarget and (weapon.directDamage or weapon.bodyDamage) or weapon.bodyDamage
   damage(attacker,target,amount,false,position)
  end
 end
end

local cooldown={smoke=16,flash=12,recon=18}
R.OnServerEvent:Connect(function(p,action,aim,expectedSlot,aiming)
 local s=S[p]; local c=p.Character
 local h=c and c:FindFirstChildOfClass("Humanoid")
 local head=c and c:FindFirstChild("Head")
 if not s or not h or h.Health&lt;=0 or not head then return end
 if action=="loadout" or action=="kit" then
  if p:GetAttribute("RiftMap")~="Lobby" or p:GetAttribute("RiftQueued") or p:GetAttribute("RiftDuelId") then return end
  if action=="kit" then
   if aim==1 or aim==2 or aim==3 then p:SetAttribute("RiftKit",aim) end
  else
   local slot=expectedSlot
   if slot==nil then slot=table.find(weapons.Loadouts[1],aim) and 1 or 2 end
   if typeof(slot)~="number" or slot%1~=0 then return end
   local definition=weapons.Slots[slot]
   if definition and typeof(aim)=="number" and table.find(weapons.Loadouts[definition.category],aim) then p:SetAttribute(definition.attribute,aim) end
  end
  return
 end
 local duel=p:GetAttribute("RiftDuelId")
 local effectParent=workspace
 if duel then
  if p:GetAttribute("RiftDuelPhase")~="Fight" or not p:GetAttribute("RiftRoundAlive") then return end
  local arena=workspace.RiftDuels:FindFirstChild(p:GetAttribute("RiftDuelArena") or "")
  effectParent=arena and arena:FindFirstChild("RoundEffects")
  if not effectParent then return end
 elseif not p:GetAttribute("RiftMap") or p:GetAttribute("RiftMap")=="Lobby" then
  return
 end
 local now=os.clock()
 if action=="equip" then
  if typeof(aim)~="number" or aim%1~=0 or not weapons.Slots[aim] or aim==s.equipped then return end
  s.reload=nil
  s.equipped=aim
  s.nextShot=math.max(s.nextShot,now+.2)
  R:FireClient(p,"weaponState",aim,s.ammo[aim],false)
  return
 end
 local slot=s.equipped
 local weaponId=s.loadout[slot]
 local weapon=weapons[weaponId]
 if action=="reload" then
  if weapon.melee then return end
  if (expectedSlot and expectedSlot~=slot) or s.reload or s.ammo[slot]==weapon.magazine then return end
  local reload={}
  s.reload=reload
  R:FireClient(p,"weaponState",slot,s.ammo[slot],true)
  task.delay(weapon.reloadTime,function()
   if S[p]~=s or s.reload~=reload then return end
   s.ammo[slot]=weapon.magazine
   s.reload=nil
   R:FireClient(p,"weaponState",slot,s.ammo[slot],false)
  end)
  return
 end
 if typeof(action)~="string" or (action~="fire" and action~="itemAlt" and not cooldown[action]) then return end
 if duel and action==weapons.Kits[p:GetAttribute("RiftKit") or 1].omitted then return end
 if typeof(aim)~="Vector3" or not (aim.Magnitude&gt;.99 and aim.Magnitude&lt;1.01) then return end
 local origin=head.Position
 local params=RaycastParams.new()
 params.FilterType=Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances={c}
 local function useItem(alt)
  Items.Use({weapon=weapon,player=p,state=s,character=c,humanoid=h,origin=origin,aim=aim,params=params,parent=effectParent,remote=R,damage=damage,blast=blast,effect=effect,enemy=enemy,ally=function(a,b) return sameCombatSpace(a,b) and (not a:GetAttribute("RiftDuelId") or a:GetAttribute("RiftTeam")==b:GetAttribute("RiftTeam")) end,valid=function() return p.Parent==P and S[p]==s and h.Health&gt;0 and effectParent.Parent~=nil and (not duel or (p:GetAttribute("RiftDuelPhase")=="Fight" and p:GetAttribute("RiftRoundAlive"))) end},alt)
 end
 if action=="itemAlt" then
  if not weapon.item or (expectedSlot and expectedSlot~=slot) or now&lt;(s.itemAltReady or 0) then return end
  if not weapon.melee and weapon.name~="Satchel" and weapon.name~="Warper" then return end
  if weapon.name=="Fists" and h.FloorMaterial~=Enum.Material.Air then return end
  s.itemAltReady=now+3; useItem(true); return
 end
 if action=="fire" then
  if (expectedSlot and expectedSlot~=slot) or s.reload or s.ammo[slot]&lt;=0 or now&lt;s.nextShot then return end
  s.nextShot=now+weapon.shotInterval
  if not weapon.melee then s.ammo[slot]-=1 end
  R:FireClient(p,"weaponState",slot,s.ammo[slot],false)
  for _,other in P:GetPlayers() do
   if other~=p and sameCombatSpace(p,other) then
    local otherHead=other.Character and other.Character:FindFirstChild("Head")
    if otherHead and (otherHead.Position-origin).Magnitude&lt;150 then
     R:FireClient(other,"shot",weaponId,head)
    end
   end
  end
  local spread=aiming==true and weapon.ads or weapon.hip
  if p:GetAttribute("RiftSprinting") or p:GetAttribute("RiftSliding") then spread=math.max(weapon.hip,spread)*1.45 end
  if weapon.item then useItem(false); return end
  if weapon.grenade then
   local ball=Instance.new("Part"); ball.Name="RiftGrenade"; ball.Shape=Enum.PartType.Ball; ball.Size=Vector3.one*.65; ball.Color=Color3.fromRGB(65,90,62); ball.CFrame=CFrame.new(origin+aim*2); ball.CanCollide=true; ball.Parent=effectParent
   ball:SetNetworkOwner(nil); ball.AssemblyLinearVelocity=aim*65+Vector3.new(0,20,0); D:AddItem(ball,3)
   task.delay(2.5,function() if ball.Parent then local position=ball.Position; ball:Destroy(); if p.Parent and S[p]==s then blast(p,effectParent,position,weapon) end end end)
   return
  end
  local hits={}
  local pellets=weapon.pellets or 1
  local pelletDamage=weapon.bodyDamage/pellets
  for pellet=1,pellets do
   local direction=aimWithSpread(aim,spread)
   local hit=workspace:Raycast(origin,direction*weapon.range,params)
   local dest=hit and hit.Position or origin+direction*weapon.range
   if pellet==1 then trace(effectParent,origin,dest) end
   if weapon.blastRadius then
    local directTarget=hit and hit.Instance:FindFirstAncestorOfClass("Model")
    blast(p,effectParent,hit and dest+hit.Normal*.15 or dest,weapon,directTarget)
   elseif hit then
    local model=hit.Instance:FindFirstAncestorOfClass("Model")
    if model then
     local headshot=hit.Instance.Name=="Head"
     local info=hits[model] or {amount=0,headshot=false}
     local falloff=weapon.pellets and math.clamp(1.2-hit.Distance/weapon.range,.22,1) or 1
     info.amount+=pelletDamage*(headshot and weapon.headMultiplier or 1)*falloff
     info.headshot=info.headshot or headshot
     hits[model]=info
    end
   end
  end
  for model,info in hits do damage(p,model,info.amount,info.headshot,origin) end
  return
 end
 if now&lt;(s.ready[action] or 0) then return end
 s.ready[action]=now+cooldown[action]
 R:FireClient(p,"cooldown",action,cooldown[action])
 R:FireClient(p,"abilityCast",action)
 local hit=workspace:Raycast(origin,aim*65,params)
 local pos=hit and (hit.Position+hit.Normal*1.6) or origin+aim*65
 if action=="smoke" then
  local cloud=effect(effectParent,pos,Vector3.one*22,Color3.fromRGB(61,45,91),0,9,true)
  cloud.Material=Enum.Material.SmoothPlastic
  R:FireAllClients("smoke",cloud)
 elseif action=="flash" then
  effect(effectParent,pos,Vector3.one*2,Color3.new(1,1,.85),0,.55,true)
  task.delay(.55,function()
   if S[p]~=s or (duel and not effectParent.Parent) then return end
   effect(effectParent,pos,Vector3.one*8,Color3.new(1,1,.9),.18,.18,true)
   for _,other in P:GetPlayers() do
    local target=other.Character and other.Character:FindFirstChild("Head")
    if target and sameCombatSpace(p,other) then
     local delta=pos-target.Position
     local sight=RaycastParams.new(); sight.FilterType=Enum.RaycastFilterType.Exclude; sight.FilterDescendantsInstances={other.Character}
     if delta.Magnitude&lt;65 and not workspace:Raycast(target.Position,delta,sight) then R:FireClient(other,"flash",pos) end
    end
   end
  end)
 else
  local pulse=effect(effectParent,pos,Vector3.one*2,Color3.fromRGB(38,240,212),.55,.65,true)
  game:GetService("TweenService"):Create(pulse,TweenInfo.new(.6),{Size=Vector3.one*80,Transparency=1}):Play()
  local function scan()
   if S[p]~=s or (duel and not effectParent.Parent) then return end
   local targets={}
   for _,other in P:GetPlayers() do
    if other~=p and other.Character and enemy(p,other) then table.insert(targets,other.Character) end
   end
   if not duel then
    for _,bot in workspace.RiftArena.Targets:GetChildren() do table.insert(targets,bot) end
   end
   for _,model in targets do
    local root=model:FindFirstChild("HumanoidRootPart")
    local hum=model:FindFirstChildOfClass("Humanoid")
    if root and hum and hum.Health&gt;0 and (root.Position-pos).Magnitude&lt;=40 then
     R:FireClient(p,"reveal",model)
    end
   end
  end
  scan()
  task.delay(1,scan)
  task.delay(2,scan)
 end
end)
local folder=workspace.RiftArena.Targets
for _,bot in folder:GetChildren() do
 local template=bot:Clone()
 local function bind(model)
  model.Humanoid.Died:Connect(function()
   task.delay(3,function() model:Destroy(); local replacement=template:Clone(); replacement.Parent=folder; bind(replacement) end)
  end)
 end
 bind(bot)
end</ProtectedString>
