				<UniqueId name="UniqueId">3c83a70e7eb853630afca5dc000011b4</UniqueId>
			</Properties>
		</Item>
		<Item class="BindableEvent" referent="RBX5d7f02d9c109401692df5ddefe20d64f">
			<Properties>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">RiftResetCombat</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">3c83a70e7eb853630afca5dc00001628</UniqueId>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX2d6e7b5e7e6d4f9cbfd0ea24cf2e324e">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local remote = game.ReplicatedStorage.RiftQueue
local resetCombat = script.Parent.RiftResetCombat
local lobby = workspace.RiftLobby
local arenas = workspace.RiftDuels:GetChildren()
table.sort(arenas, function(a,b) return a.Name < b.Name end)

local WINS_REQUIRED = 3
local ROUND_SECONDS = 60
local queue = {}
local occupied = {}
local matches = {}
local requestAt = {}
local lastArena = 0
local nextId = 0

local function living(player)
 local character = player.Character
 local humanoid = character and character:FindFirstChildOfClass("Humanoid")
 local root = character and character:FindFirstChild("HumanoidRootPart")
 if humanoid and humanoid.Health > 0 and root then
  return character, humanoid, root
 end
end

local function returnToLobby(player)
 if player.Parent ~= Players then return end
 player:SetAttribute("RiftMap", "Lobby")
 local character, humanoid, root = living(player)
 if character then
  local spawn = lobby.LobbySpawn.CFrame
  character:PivotTo(spawn + Vector3.new(0,3,0))
  root.AssemblyLinearVelocity = Vector3.zero
  root.Anchored = false
  humanoid.Health = humanoid.MaxHealth
  resetCombat:Fire(player)
 end
end

local function removeFromQueue(player)
 local index = table.find(queue, player)
 if index then table.remove(queue, index) end
 player:SetAttribute("RiftQueued", false)
end

local function status(match, phase, seconds, message)
 match.phase = phase
 local deadline = workspace:GetServerTimeNow() + seconds
 for index, player in match.players do
  if player.Parent == Players then
   player:SetAttribute("RiftDuelPhase", phase)
   player:SetAttribute("RiftDuelDeadline", deadline)
   player:SetAttribute("RiftDuelScore", string.format("%d  –  %d", match.score[index], match.score[3-index]))
   player:SetAttribute("RiftDuelMessage", message)
  end
 end
end

local function clearRound(match)
 for _, connection in match.deaths do connection:Disconnect() end
 table.clear(match.deaths)
 if match.effects then
  match.effects:Destroy()
  match.effects = nil
 end
end

local function finish(match, message)
 if match.phase == "Finished" then return end
 clearRound(match)
 status(match, "Finished", 3, message)
 task.delay(3, function()
  for _, player in match.players do
   matches[player] = nil
   if player.Parent == Players then
    player:SetAttribute("RiftDuelId", nil)
    player:SetAttribute("RiftDuelPhase", nil)
    player:SetAttribute("RiftDuelArena", nil)
    returnToLobby(player)
   end
  end
  occupied[match.arena] = nil
 end)
end

local startRound

local function endRound(match, winner)
 if match.phase ~= "Fight" then return end
 clearRound(match)
 local message = "Round drawn"
 if winner then
  match.score[winner] += 1
  message = match.players[winner].DisplayName .. " wins the round"
  if match.score[winner] >= WINS_REQUIRED then
   finish(match, match.players[winner].DisplayName .. " wins the duel")
   return
  end
 end
 if match.round >= 9 then
  local a, b = match.score[1], match.score[2]
  finish(match, a == b and "Duel drawn" or (match.players[a > b and 1 or 2].DisplayName .. " wins the duel"))
  return
 end
 status(match, "Intermission", 4, message)
 task.delay(4, function()
  if match.phase == "Intermission" then startRound(match) end
 end)
end

startRound = function(match)
 match.round += 1
 status(match, "Preparing", 0, "Preparing round " .. match.round)
 local limit = os.clock() + 12
 local function ready()
  for _, player in match.players do
   if not living(player) then return false end
  end
  return true
 end
 while match.phase == "Preparing" and not ready() and os.clock() < limit do
  task.wait(.2)
 end
 if match.phase ~= "Preparing" then return end
 if not ready() then
  finish(match, "Duel ended · player could not respawn")
  return
 end
 local spawns = {match.arena:GetAttribute("SpawnA"), match.arena:GetAttribute("SpawnB")}
 local roots = {}
 for index, player in match.players do
  local character, humanoid, root = living(player)
  character:PivotTo(CFrame.lookAt(spawns[index], spawns[3-index]))
  root.AssemblyLinearVelocity = Vector3.zero
  root.Anchored = true
  roots[index] = root
  humanoid.Health = humanoid.MaxHealth
  resetCombat:Fire(player)
  match.deaths[index] = humanoid.Died:Connect(function()
   if match.phase == "Fight" then
    endRound(match, 3-index)
   elseif match.phase == "Countdown" then
    finish(match, match.players[3-index].DisplayName .. " wins by forfeit")
   end
  end)
 end
 status(match, "Countdown", 3, "Round " .. match.round)
 task.wait(3)
 for _, root in roots do
  if root.Parent then root.Anchored = false end
 end
 if match.phase ~= "Countdown" then return end
 local effects = Instance.new("Folder")
 effects.Name = "RoundEffects"
 effects.Parent = match.arena
 match.effects = effects
 status(match, "Fight", ROUND_SECONDS, "Round " .. match.round)
 local round = match.round
 task.delay(ROUND_SECONDS, function()
  if match.phase == "Fight" and match.round == round then endRound(match, nil) end
 end)
end

local function matchmake()
 while #queue >= 2 do
  local arena
  for offset = 1, #arenas do
   local index = (lastArena + offset - 1) % #arenas + 1
   if not occupied[arenas[index]] then
    lastArena = index
    arena = arenas[index]
    break
   end
  end
  if not arena then return end
  local pair = {queue[1], queue[2]}
  for _, player in pair do removeFromQueue(player) end
  nextId += 1
  local match = {players=pair, arena=arena, score={0,0}, round=0, deaths={}}
  occupied[arena] = match
  for _, player in pair do
   matches[player] = match
   player:SetAttribute("RiftDuelId", nextId)
   player:SetAttribute("RiftDuelArena", arena.Name)
   player:SetAttribute("RiftMap", nil)
  end
  task.spawn(startRound, match)
 end
end

local function toggleQueue(player)
 if matches[player] or player:GetAttribute("RiftMap") ~= "Lobby" then return end
 local _, _, root = living(player)
 if not root or (root.Position-lobby.LobbySpawn.Position).Magnitude > 84 then return end
 local now = os.clock()
 if now - (requestAt[player] or -10) < .5 then return end
 requestAt[player] = now
 if table.find(queue, player) then
  removeFromQueue(player)
 else
  table.insert(queue, player)
  player:SetAttribute("RiftQueued", true)
  matchmake()
 end
end

local function bind(player)
 if player:GetAttribute("RiftMap") == nil then player:SetAttribute("RiftMap", "Lobby") end
 player.CharacterAdded:Connect(function()
  removeFromQueue(player)
 end)
end
Players.PlayerAdded:Connect(bind)
for _, player in Players:GetPlayers() do bind(player) end
Players.PlayerRemoving:Connect(function(player)
 removeFromQueue(player)
 requestAt[player] = nil
 local match = matches[player]
 if match and match.phase ~= "Finished" then
  local other = match.players[1] == player and match.players[2] or match.players[1]
  finish(match, other.DisplayName .. " wins by forfeit")
 end
end)
remote.OnServerEvent:Connect(toggleQueue)
lobby.QueueTerminal.JoinDuel.Triggered:Connect(toggleQueue)
task.spawn(function()
 while task.wait(1) do matchmake() end
end)
]]></ProtectedString>
